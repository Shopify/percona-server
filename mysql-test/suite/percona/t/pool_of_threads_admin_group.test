--source include/not_windows.inc
--source include/have_perfschema.inc

--echo # Admin port connections share a dedicated thread group that can grow
--echo # past the thread limit, even for statements on existing connections.

--disable_query_log
CALL mtr.add_suppression("Failed to initialize TLS for channel");
CALL mtr.add_suppression("Failed to set up SSL because of the following SSL");
CALL mtr.add_suppression("Threadpool could not create additional thread to handle queries");
--enable_query_log

--let $restart_parameters=restart:--thread-handling=pool-of-threads --thread-pool-size=1 --thread-pool-max-threads=2 --admin-address=127.0.0.1 --innodb-lock-wait-timeout=120
--source include/restart_mysqld.inc
--source include/have_pool_of_threads.inc

CREATE TABLE t1 (id INT PRIMARY KEY, v INT NOT NULL) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0);

--echo # Open admin connections before saturating the pool, and resize it.
--connect (adm, 127.0.0.1, root,, test, $MASTER_ADMINPORT)
SET GLOBAL thread_pool_size = 2;
SELECT @@GLOBAL.thread_pool_size;
SET GLOBAL thread_pool_size = 1;
SELECT @@GLOBAL.thread_pool_size;
--connect (adm1, 127.0.0.1, root,, test, $MASTER_ADMINPORT)
--let $adm1_id = `SELECT CONNECTION_ID()`
--connect (adm2, 127.0.0.1, root,, test, $MASTER_ADMINPORT)
--let $adm2_id = `SELECT CONNECTION_ID()`

--connect (holder, localhost, root,, test)
BEGIN;
SELECT id FROM t1 WHERE id = 1 FOR UPDATE;
--connect (w1, localhost, root,, test)
--let $w1_id = `SELECT CONNECTION_ID()`
--connect (w2, localhost, root,, test)
--let $w2_id = `SELECT CONNECTION_ID()`
--connect (w3, localhost, root,, test)

--echo # Both regular workers block; a third regular statement cannot start.
--connection w1
--send UPDATE t1 SET v = v + 1 WHERE id = 1
--connection adm
--let $wait_condition = SELECT COUNT(DISTINCT REQUESTING_ENGINE_TRANSACTION_ID) = 1 FROM performance_schema.data_lock_waits
--source include/wait_condition.inc
--connection w2
--send UPDATE t1 SET v = v + 1 WHERE id = 1
--connection adm
--let $wait_condition = SELECT COUNT(DISTINCT REQUESTING_ENGINE_TRANSACTION_ID) = 2 FROM performance_schema.data_lock_waits
--source include/wait_condition.inc
--connection w3
--send UPDATE t1 SET v = v + 1 WHERE id = 1

--echo # Block admin workers too. The existing admin connection still works.
--connection adm1
--send UPDATE t1 SET v = v + 1 WHERE id = 1
--connection adm
--let $wait_condition = SELECT COUNT(DISTINCT REQUESTING_ENGINE_TRANSACTION_ID) = 3 FROM performance_schema.data_lock_waits
--source include/wait_condition.inc
--connection adm2
--send UPDATE t1 SET v = v + 1 WHERE id = 1
--connection adm
--let $wait_condition = SELECT COUNT(DISTINCT REQUESTING_ENGINE_TRANSACTION_ID) = 4 FROM performance_schema.data_lock_waits
--source include/wait_condition.inc
SELECT COUNT(DISTINCT REQUESTING_ENGINE_TRANSACTION_ID) AS blocked_statements FROM performance_schema.data_lock_waits;
# Two regular workers, two blocked admin workers, and this admin worker.
# This also verifies that admin workers are counted in thread pool statistics.
SELECT VARIABLE_VALUE >= 5 AS admin_workers_in_pool
  FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Threadpool_threads';

--echo # New admin connections can also log in while the regular pool is full.
--connect (adm_new, 127.0.0.1, root,, test, $MASTER_ADMINPORT)
SELECT 'new admin connection ok';
--disconnect adm_new

--echo # The existing admin connection clears the pile-up.
--connection adm
--replace_result $adm1_id ADM1_ID
--eval KILL QUERY $adm1_id
--replace_result $adm2_id ADM2_ID
--eval KILL QUERY $adm2_id
--replace_result $w1_id W1_ID
--eval KILL QUERY $w1_id
--replace_result $w2_id W2_ID
--eval KILL QUERY $w2_id
--connection adm1
--error ER_QUERY_INTERRUPTED
--reap
--connection adm2
--error ER_QUERY_INTERRUPTED
--reap
--connection w1
--error ER_QUERY_INTERRUPTED
--reap
--connection w2
--error ER_QUERY_INTERRUPTED
--reap
--connection holder
ROLLBACK;
--connection w3
--reap

--connection default
--disconnect adm
--disconnect adm1
--disconnect adm2
--disconnect holder
--disconnect w1
--disconnect w2
--disconnect w3
SELECT v FROM t1;
DROP TABLE t1;

--let $restart_parameters=
--source include/restart_mysqld.inc
